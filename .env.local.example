# ContentHub — local development environment template
# Copy to .env.local and adjust if needed (defaults work out of the box).
# These credentials are dev-only; NEVER use in staging or production.
#
#   cp .env.local.example .env.local

# ── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=contenthub
POSTGRES_USER=contenthub
POSTGRES_PASSWORD=contenthub

# ── MongoDB ─────────────────────────────────────────────────────────────────
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=contenthub
MONGO_USER=contenthub
MONGO_PASSWORD=contenthub

# ── Kafka ────────────────────────────────────────────────────────────────────
# App on the host connects via PLAINTEXT_HOST listener (29092).
# Containers connect to each other via kafka:9092 (internal).
KAFKA_BOOTSTRAP_SERVERS=localhost:29092
KAFKA_HOST_PORT=29092
SCHEMA_REGISTRY_URL=http://localhost:8081
SCHEMA_REGISTRY_PORT=8081

# ── LocalStack (AWS S3 emulation) ────────────────────────────────────────────
LOCALSTACK_PORT=4566
AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_REGION=us-east-1
S3_MEDIA_BUCKET=contenthub-media-local
S3_RENDERS_BUCKET=contenthub-renders-local
# Uncomment and set for LocalStack Pro features (Cognito, SQS, etc.):
# LOCALSTACK_AUTH_TOKEN=

# ── OIDC / Identity (local stand-in for Amazon Cognito — ADR-0004) ───────────
MOCK_OAUTH2_PORT=8090
# The Spring Gateway uses this as spring.security.oauth2.resourceserver.jwt.issuer-uri
OIDC_ISSUER_URI=http://localhost:8090/contenthub
OIDC_JWK_SET_URI=http://localhost:8090/contenthub/jwks

# ── Observability ─────────────────────────────────────────────────────────────
# Spring Boot sets OTEL_EXPORTER_OTLP_ENDPOINT to send traces to the OTel Collector.
OTEL_SERVICE_NAME=contenthub
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
JAEGER_UI_PORT=16686
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001

# ── Application ───────────────────────────────────────────────────────────────
APP_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# ── GitHub Actions secrets / variables ────────────────────────────────────────
# These are NOT used by docker-compose. They are documented here so every
# required GitHub secret and variable is in one place. Set them at:
#   GitHub repo → Settings → Secrets and variables → Actions
#
# SECRETS (encrypted, never visible after saving):
#
#   ANTHROPIC_API_KEY      Claude PR review (claude-pr-review.yml)
#                          Get from: console.anthropic.com → API Keys
#
#   SNYK_TOKEN             Snyk OSS SCA dependency scan (ci.yml)
#                          Get from: app.snyk.io → Settings → Service accounts
#
#   SONAR_TOKEN            SonarCloud quality gate (ci.yml)
#                          Get from: sonarcloud.io → My Account → Security
#
#   AWS_CI_ROLE_ARN        IAM role for CI to push images to ECR (ci.yml publish job)
#                          Format: arn:aws:iam::<account-id>:role/contenthub-ci
#                          Requires OIDC provider set up in AWS IAM (one-time)
#
#   AWS_QA_ROLE_ARN        IAM role for ephemeral QA deploy (qa-deploy.yml — PAUSED)
#                          Format: arn:aws:iam::<account-id>:role/contenthub-qa-deploy
#                          See docs/08-deployment-cicd.md §2.2 for full prerequisites
#
# VARIABLES (plain text, visible after saving):
#
#   AWS_REGION             e.g. us-east-1
#   TF_STATE_BUCKET        S3 bucket name for Terraform state (qa-deploy.yml — PAUSED)
#                          e.g. contenthub-tf-state-<account-id>
