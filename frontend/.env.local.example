# ContentHub frontend — local dev environment
# Copy to .env.local (gitignored). Defaults below work with the docker-compose stack.
#
#   cp .env.local.example .env.local

# OIDC / Auth (mock-oauth2 locally; Cognito in prod — ADR-0004)
VITE_OIDC_AUTHORITY=http://localhost:8090/contenthub
VITE_OIDC_CLIENT_ID=contenthub-spa
VITE_OIDC_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_OIDC_SCOPE=openid profile email
